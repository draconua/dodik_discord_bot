{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "A feature-rich Discord music bot using discord.js v14 and DisTube with Spotify support",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "music-bot",
    "distube",
    "discordjs-v14",
    "spotify"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.18.0",
    "@distube/spotify": "^2.0.2",
    "@distube/yt-dlp": "^2.0.1",
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.4.0",
    "discord.js": "^14.14.1",
    "distube": "^5.0.4",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.13",
    "opusscript": "^0.0.8",
    "tweetnacl": "^1.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "@discordjs/opus@0.9.0": true,
    "@distube/yt-dlp@2.0.1": true,
    "ffmpeg-static@5.3.0": true
  }
}
